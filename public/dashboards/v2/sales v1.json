              },
              "color": {
                "field": "ProfitStatus",
                "type": "nominal",
                "scale": {
                  "domain": ["Profit", "Loss"],
                  "range": ["#00a2d3", "#ef5323"]
                },
                "legend": null
              },
              "opacity": {"condition": {"param": "subcat_sel", "value": 1}, "value": 0.3},
              "tooltip": [
                {"field": "SubCategory", "type": "nominal", "title": "Subcategory"},
                {"field": "Profit2023", "type": "quantitative", "format": "$,", "title": "2023 Profit"}
              ]
            }
          }
        ]
      }
