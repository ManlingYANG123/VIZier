      "spec": {
        "width": 560,
        "height": 560,
        "background": null,
        "config": {
          "view": { "stroke": null },
          "axis": {
            "domainColor": "#1e3a5f",
            "gridColor": "#e8f1f5",
            "tickColor": "#1e3a5f",
            "labelColor": "#1e3a5f",
            "labelFontSize": 11,
            "labelFont": "JetBrains Mono, monospace",
