          "opacity": { "condition": { "param": "depth_group_sel", "value": 0.9 }, "value": 0.25 },
          "tooltip": [
            { "field": "group", "type": "nominal", "title": "Marine Group" },
            { "field": "depth", "type": "quantitative", "format": ",", "title": "Max Depth (m)" },
            { "field": "fact", "type": "nominal", "title": "Fact" }
          ]
        }
      }
    },
    {
      "id": "species-comparison",
      "label": "Biodiversity vs Depth Capability",
      "subtitle": "Species count plotted against maximum recorded depth — click a legend entry to highlight one group",
