{
  "dashboard": {
    "id": "ocean-life",
    "title": "Ocean Biodiversity Atlas",
    "subtitle": "Exploring species diversity and depth capabilities across major marine groups · use the controls to focus the atlas",
    "hasKpis": false,
    "filters": [
      {
        "id": "marine-group-filter",
        "label": "Marine group",
        "kind": "category",
        "field": "group",
        "targets": ["species-diversity", "depth-range", "species-comparison"],
        "options": ["Crustaceans", "Fish", "Cephalopods", "Seabirds", "Cetaceans"],
        "value": null,
        "wired": false,
        "variant": "select",
        "placement": "left-rail",
        "container": "ruled",
        "tone": "accent",
        "accent": "#1e3a5f"
      },
      {
        "id": "depth-threshold",
        "label": "Maximum depth (m)",
        "kind": "range",
        "field": "depth",
        "targets": ["depth-range", "species-comparison"],
        "min": 1000,
        "max": 11000,
        "step": 500,
        "value": 11000,
        "wired": true,
        "variant": "slider",
        "placement": "left-rail",
        "container": "panel",
        "tone": "contrast",
        "accent": "#1e3a5f"
      }
    ]
  },
  "tiles": [
    {
      "id": "species-diversity",
      "label": "Species Diversity by Group",
      "subtitle": "Known species count across major marine groups — click a legend entry to highlight one group",
      "bounds": { "x": 748, "y": 144, "w": 324, "h": 180 },
      "spec": {
        "width": 580,
        "height": 240,
        "background": null,
        "config": {
          "view": { "stroke": null },
          "axis": {
            "domainColor": "#1e3a5f",
            "gridColor": "#e8f1f5",
            "tickColor": "#1e3a5f",
            "labelColor": "#1e3a5f",
            "labelFontSize": 11,
            "labelFont": "JetBrains Mono, monospace",
            "titleFontSize": 12
          }
        },
        "data": {
          "values": [
            { "group": "Crustaceans", "count": 67000, "species": "Crustaceans" },
            { "group": "Fish", "count": 34000, "species": "Fish" },
            { "group": "Cephalopods", "count": 800, "species": "Cephalopods" },
            { "group": "Seabirds", "count": 350, "species": "Seabirds" },
            { "group": "Cetaceans", "count": 89, "species": "Cetaceans" }
          ]
        },
        "params": [
          { "name": "group_sel", "select": { "type": "point", "fields": ["group"] }, "bind": "legend" }
        ],
        "mark": { "type": "bar", "cornerRadiusEnd": 6, "cursor": "pointer" },
        "encoding": {
          "y": {
            "field": "group",
            "type": "nominal",
            "sort": { "field": "count", "order": "descending" },
            "axis": { "title": null, "labelFontSize": 12 }
          },
          "x": {
            "field": "count",
            "type": "quantitative",
            "scale": { "type": "sqrt", "zero": true },
            "axis": { "title": "Known Species (square-root scale)", "titleFontSize": 11 }
          },
          "color": {
            "field": "group",
            "type": "nominal",
            "scale": {
              "domain": ["Crustaceans", "Fish", "Cephalopods", "Seabirds", "Cetaceans"],
              "range": ["#ff7f50", "#4682b4", "#9370db", "#ffd700", "#20b2aa"]
            },
            "legend": { "orient": "bottom", "title": null, "labelFontSize": 11 }
          },
          "opacity": { "condition": { "param": "group_sel", "value": 0.9 }, "value": 0.25 },
          "tooltip": [
            { "field": "group", "type": "nominal", "title": "Marine Group" },
            { "field": "count", "type": "quantitative", "format": ",", "title": "Species Count" }
          ]
        }
      }
    },
    {
