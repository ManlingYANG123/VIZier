          },
          "opacity": { "condition": { "param": "group_sel", "value": 0.85 }, "value": 0.15 },
          "tooltip": [
            { "field": "group", "type": "nominal", "title": "Group" },
            { "field": "count", "type": "quantitative", "format": ",", "title": "Species Count" },
