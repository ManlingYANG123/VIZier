        "encoding": {
          "x": {
            "field": "depth",
            "type": "quantitative",
            "scale": { "type": "log" },
            "axis": { "title": "Maximum Depth (meters, log scale)", "format": ",", "grid": true }
          },
          "y": {
            "field": "count",
            "type": "quantitative",
            "scale": { "type": "log" },
            "axis": { "title": "Species Count (log scale)", "format": ",", "grid": true }
          },
          "color": {
            "field": "group",
            "type": "nominal",
            "scale": {
              "domain": ["Crustaceans", "Fish", "Cephalopods", "Seabirds", "Cetaceans"],
