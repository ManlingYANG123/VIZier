      "bounds": { "x": 816, "y": 144, "w": 256, "h": 576 },
      "spec": {
        "width": 216,
        "height": 536,
        "background": null,
        "config": {
          "font": "'Trebuchet MS', 'Segoe UI', -apple-system, sans-serif",
          "view": { "stroke": null }
        },
        "data": { "values": [{ "x": 0 }] },
        "layer": [
          {
            "mark": { "type": "text", "fontSize": 15, "lineHeight": 22, "color": "#1b1b1b", "align": "left", "baseline": "top", "x": 4, "y": 6, "limit": 214, "lineBreak": "\n" },
            "encoding": { "text": { "value": "Air quality was 'Good'\non 238 days in 2024.\n\nMost 'Moderate' days\nfell in July and August,\nwhen ozone peaks in\nthe summer heat." } }
          },
          {
            "mark": { "type": "text", "fontSize": 14, "fontWeight": "bold", "color": "#1a4480", "align": "left", "baseline": "top", "x": 4, "y": 256, "limit": 214 },
            "encoding": { "text": { "value": "On a bad-air day:" } }
          },
          {
            "mark": { "type": "text", "fontSize": 14, "lineHeight": 21, "color": "#1b1b1b", "align": "left", "baseline": "top", "x": 4, "y": 282, "limit": 214, "lineBreak": "\n" },
            "encoding": { "text": { "value": "• Limit long or intense\n  time outdoors\n• Keep windows closed\n• Check the forecast\n  before exercising\n  outside" } }
          },
          {
            "mark": { "type": "text", "fontSize": 11, "lineHeight": 15, "color": "#71767a", "align": "left", "baseline": "top", "x": 4, "y": 430, "limit": 214, "lineBreak": "\n" },
            "encoding": { "text": { "value": "Source: EPA AQI bands;\nvalues illustrative." } }
          }
        ]
      }
    }
  ]
}
