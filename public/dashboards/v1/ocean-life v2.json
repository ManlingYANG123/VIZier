            "legend": null
          },
          "tooltip": [
            { "field": "group", "type": "nominal", "title": "Group" },
            { "field": "count", "type": "quantitative", "format": ",", "title": "Known Species" },
            { "field": "icon", "type": "nominal", "title": " " }
          ]
        }
      }
