        "width": 580,
        "height": 280,
        "background": null,
        "config": {
          "view": { "stroke": null },
          "axis": {
            "domainColor": "#cbd5e0",
            "gridColor": "#f1f5f9",
            "tickColor": "#cbd5e0",
            "labelColor": "#64748b",
            "labelFontSize": 11,
            "titleColor": "#475569",
            "titleFontSize": 12,
            "titleFont": "Inter, sans-serif"
          },
          "legend": {
            "labelColor": "#1e293b",
            "labelFontSize": 11,
            "titleColor": "#475569"
          }
        },
        "data": {
          "values": [
            { "group": "Crustaceans", "count": 67000, "icon": "🦐" },
            { "group": "Fish", "count": 34000, "icon": "🐟" },
            { "group": "Molluscs", "count": 85000, "icon": "🐚" },
