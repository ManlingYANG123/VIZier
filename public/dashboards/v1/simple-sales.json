{
  "dashboard": {
    "id": "simple-sales",
    "title": "Monthly Sales",
    "subtitle": "Simple sales overview for Q1 2026",
    "hasKpis": false
  },
  "tiles": [
    {
      "id": "sales-bar",
      "label": "Sales by Month",
      "subtitle": "Revenue trending upward",
      "bounds": { "x": 40, "y": 100, "w": 600, "h": 300 },
      "spec": {
        "width": 580,
        "height": 280,
        "background": "white",
        "data": {
          "values": [
            { "month": "January", "sales": 12000 },
            { "month": "February", "sales": 15000 },
            { "month": "March", "sales": 18000 }
          ]
        },
        "mark": {
          "type": "bar",
          "color": "#3b82f6",
          "cornerRadiusEnd": 4
        },
        "encoding": {
          "x": {
            "field": "month",
            "type": "nominal",
            "axis": { "title": "Month" }
          },
          "y": {
            "field": "sales",
            "type": "quantitative",
            "axis": { "title": "Sales ($)", "format": "," }
          },
          "tooltip": [
            { "field": "month", "type": "nominal" },
            { "field": "sales", "type": "quantitative", "format": "," }
          ]
        }
      }
    },
    {
      "id": "sales-line",
      "label": "Sales Trend",
      "subtitle": "Growth over time",
      "bounds": { "x": 660, "y": 100, "w": 600, "h": 300 },
      "spec": {
        "width": 580,
        "height": 280,
        "background": "white",
        "data": {
          "values": [
            { "month": "January", "sales": 12000 },
            { "month": "February", "sales": 15000 },
            { "month": "March", "sales": 18000 }
          ]
        },
        "mark": {
          "type": "line",
          "point": true,
          "color": "#10b981",
          "strokeWidth": 3
        },
        "encoding": {
          "x": {
            "field": "month",
            "type": "ordinal",
            "axis": { "title": "Month" }
          },
          "y": {
            "field": "sales",
            "type": "quantitative",
            "axis": { "title": "Sales ($)", "format": "," }
          },
          "tooltip": [
            { "field": "month", "type": "ordinal" },
            { "field": "sales", "type": "quantitative", "format": "," }
          ]
        }
      }
    }
  ]
}
