    {
      "id": "region-performance",
      "label": "Revenue by Region",
      "subtitle": "Click a region to filter the trend and category views · double-click to clear",
      "bounds": { "x": 28, "y": 288, "w": 610, "h": 456 },
      "spec": {
        "width": 570,
        "height": 416,
        "background": null,
        "config": {
          "font": "'SF Mono', Menlo, Consolas, 'Roboto Mono', monospace",
          "view": { "stroke": null },
          "axis": {
            "labelColor": "#475569",
            "titleColor": "#64748b",
            "gridColor": "#eef2f7",
            "domain": false,
            "tickSize": 0,
            "labelFontSize": 13,
            "titleFontSize": 12
          }
        },
        "data": {
          "values": [
            { "region": "West", "revenue": 1180000 },
            { "region": "North", "revenue": 980000 },
            { "region": "Central", "revenue": 868000 },
            { "region": "South", "revenue": 720000 },
            { "region": "East", "revenue": 530000 }
          ]
        },
        "params": [
          { "name": "region_select", "select": { "type": "point", "fields": ["region"], "on": "click", "clear": "dblclick" } }
        ],
        "mark": { "type": "bar", "cornerRadius": 2, "cursor": "pointer", "color": "#2563eb" },
        "encoding": {
          "y": {
            "field": "region",
            "type": "nominal",
            "sort": { "field": "revenue", "order": "descending" },
            "axis": { "title": null, "labelFontSize": 14 }
          },
          "x": {
            "field": "revenue",
            "type": "quantitative",
            "axis": { "title": "Revenue", "format": "$.2s", "grid": true }
          },
          "opacity": { "condition": { "param": "region_select", "value": 1 }, "value": 0.4 },
          "tooltip": [
            { "field": "region", "type": "nominal", "title": "Region" },
            { "field": "revenue", "type": "quantitative", "format": "$,", "title": "Revenue" }
          ]
        },
        "usermeta": {
          "crossFilter": {
            "role": "source",
            "param": "region_select",
            "field": "region",
            "source": "region-performance",
            "targets": ["revenue-trend", "category-mix"]
          }
        }
      }
    },
