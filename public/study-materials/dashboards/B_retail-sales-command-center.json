{
  "dashboard": {
    "id": "sales-command-center",
    "title": "Retail Sales Command Center",
    "subtitle": "Trailing six months (Apr–Sep 2026) across regions · use the controls or click a region bar",
    "hasKpis": false,
    "filters": [
      {
        "id": "region-filter",
        "label": "Region",
        "kind": "category",
        "field": "region",
        "targets": ["region-performance", "revenue-trend", "category-mix"],
        "options": ["West", "North", "Central", "South", "East"],
        "value": null,
        "wired": true,
        "variant": "chips",
        "placement": "top-row",
        "container": "ruled",
        "tone": "accent",
        "accent": "#2563eb"
      },
      {
        "id": "revenue-threshold",
        "label": "Maximum revenue",
        "kind": "range",
        "field": "revenue",
        "targets": ["region-performance"],
        "min": 0,
        "max": 1200000,
        "step": 100000,
        "value": 1200000,
        "wired": true,
        "variant": "slider",
        "placement": "floating",
        "container": "plain",
        "tone": "neutral",
        "accent": "#2563eb",
        "position": { "x": 748, "y": 91, "w": 294 }
      }
    ]
  },
  "tiles": [
    {
      "id": "kpi-revenue",
      "label": "Total Revenue",
      "bounds": { "x": 28, "y": 144, "w": 336, "h": 120 },
      "spec": {
        "width": 300,
        "height": 64,
        "background": null,
        "config": { "font": "Georgia, 'Times New Roman', serif", "view": { "stroke": null } },
        "data": { "values": [{ "x": 0 }] },
        "layer": [
          {
            "mark": { "type": "text", "fontSize": 40, "fontWeight": "bold", "color": "#0f172a", "align": "center", "baseline": "middle", "dy": -8 },
            "encoding": { "text": { "value": "$4.28M" } }
          },
          {
            "mark": { "type": "text", "fontSize": 13, "fontWeight": "bold", "color": "#2563eb", "align": "center", "baseline": "middle", "dy": 22 },
