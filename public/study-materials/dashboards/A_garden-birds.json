{
  "dashboard": {
    "id": "garden-birds",
    "title": "Britain's Garden Birds",
    "subtitle": "Who is really visiting UK gardens — and which favourites are quietly disappearing",
    "hasKpis": false,
    "filters": [
      {
        "id": "bird-focus-filter",
        "label": "Bird",
        "kind": "category",
        "field": "bird",
        "targets": ["birds-ranking", "population-trend"],
        "options": ["House Sparrow", "Starling", "Blue Tit"],
        "value": null,
        "wired": true,
        "variant": "checkboxes",
        "placement": "left-rail",
        "container": "panel",
        "tone": "accent",
        "accent": "#5b7a6b"
      }
    ]
  },
  "tiles": [
    {
      "id": "birds-ranking",
      "label": "Britain's Most-Spotted Garden Birds",
      "subtitle": "Average birds seen per garden · RSPB Big Garden Birdwatch (illustrative) · click a bird to spotlight it",
      "bounds": { "x": 228, "y": 144, "w": 378, "h": 560 },
      "spec": {
        "width": 430,
        "height": 520,
        "background": null,
        "config": {
          "font": "'Palatino Linotype', Palatino, 'Book Antiqua', Georgia, serif",
          "view": { "stroke": null },
          "axis": {
            "labelColor": "#5b5147",
            "titleColor": "#8a7f72",
            "gridColor": "#efe7d8",
            "domain": false,
            "tickSize": 0,
            "labelFontSize": 12,
            "titleFontSize": 12
          }
        },
        "data": {
          "values": [
            { "bird": "House Sparrow", "count": 4.3 },
            { "bird": "Blue Tit", "count": 3.0 },
            { "bird": "Starling", "count": 2.8 },
            { "bird": "Woodpigeon", "count": 2.4 },
            { "bird": "Blackbird", "count": 2.3 },
            { "bird": "Goldfinch", "count": 1.6 },
            { "bird": "Great Tit", "count": 1.5 },
            { "bird": "Robin", "count": 1.4 },
            { "bird": "Magpie", "count": 1.3 },
            { "bird": "Long-tailed Tit", "count": 1.2 }
          ]
        },
        "params": [
          { "name": "bird_sel", "select": { "type": "point", "fields": ["bird"], "on": "click", "clear": "dblclick" } }
        ],
        "mark": { "type": "bar", "cornerRadiusEnd": 7, "cursor": "pointer", "color": "#5b7a6b" },
        "encoding": {
          "y": {
            "field": "bird",
            "type": "nominal",
            "sort": { "field": "count", "order": "descending" },
            "axis": { "title": null, "labelFontSize": 13 }
          },
          "x": {
            "field": "count",
            "type": "quantitative",
            "axis": { "title": "Average birds per garden", "grid": true }
          },
          "opacity": { "condition": { "param": "bird_sel", "value": 1 }, "value": 0.3 },
          "tooltip": [
            { "field": "bird", "type": "nominal", "title": "Bird" },
            { "field": "count", "type": "quantitative", "title": "Avg per garden" }
          ]
        }
      }
    },
    {
      "id": "population-trend",
      "label": "Winners and Losers, 1979–2023",
      "subtitle": "Population index (1979 = 100) · dashed lines are in long-term decline · click a legend name to focus",
      "bounds": { "x": 630, "y": 144, "w": 442, "h": 268 },
      "spec": {
        "width": 510,
        "height": 228,
        "background": null,
        "config": {
          "font": "Arial, Helvetica, sans-serif",
          "view": { "stroke": null },
          "axis": {
            "labelColor": "#5b5147",
            "titleColor": "#8a7f72",
            "gridColor": "#efe7d8",
            "domain": false,
            "tickSize": 0,
            "labelFontSize": 12,
            "titleFontSize": 12
          },
          "legend": { "labelColor": "#4a4137", "labelFontSize": 12, "titleColor": "#8a7f72" }
        },
        "data": {
          "values": [
            { "bird": "House Sparrow", "year": 1979, "index": 100 },
            { "bird": "House Sparrow", "year": 1990, "index": 75 },
            { "bird": "House Sparrow", "year": 2000, "index": 55 },
            { "bird": "House Sparrow", "year": 2010, "index": 48 },
            { "bird": "House Sparrow", "year": 2020, "index": 45 },
            { "bird": "House Sparrow", "year": 2023, "index": 47 },
            { "bird": "Starling", "year": 1979, "index": 100 },
            { "bird": "Starling", "year": 1990, "index": 80 },
            { "bird": "Starling", "year": 2000, "index": 62 },
            { "bird": "Starling", "year": 2010, "index": 52 },
            { "bird": "Starling", "year": 2020, "index": 44 },
            { "bird": "Starling", "year": 2023, "index": 42 },
            { "bird": "Blue Tit", "year": 1979, "index": 100 },
            { "bird": "Blue Tit", "year": 1990, "index": 110 },
            { "bird": "Blue Tit", "year": 2000, "index": 118 },
            { "bird": "Blue Tit", "year": 2010, "index": 122 },
            { "bird": "Blue Tit", "year": 2020, "index": 124 },
            { "bird": "Blue Tit", "year": 2023, "index": 123 }
          ]
        },
        "params": [
          { "name": "species_sel", "select": { "type": "point", "fields": ["bird"] }, "bind": "legend" }
        ],
        "mark": { "type": "line", "point": { "filled": true, "size": 55 }, "strokeWidth": 2.6 },
        "encoding": {
          "x": {
            "field": "year",
            "type": "quantitative",
            "axis": { "title": null, "format": "d", "values": [1979, 1990, 2000, 2010, 2020] }
          },
          "y": {
            "field": "index",
            "type": "quantitative",
            "scale": { "zero": true },
            "axis": { "title": "Index (1979 = 100)", "grid": true }
          },
          "color": {
            "field": "bird",
            "type": "nominal",
            "scale": {
              "domain": ["House Sparrow", "Starling", "Blue Tit"],
              "range": ["#d1603d", "#b5893a", "#3a6b8a"]
            },
            "legend": { "title": null, "orient": "top-right" }
          },
          "strokeDash": {
            "field": "bird",
            "type": "nominal",
            "scale": {
              "domain": ["House Sparrow", "Starling", "Blue Tit"],
              "range": [[6, 3], [6, 3], [1, 0]]
            },
            "legend": { "title": null, "orient": "top-right" }
          },
          "opacity": { "condition": { "param": "species_sel", "value": 1 }, "value": 0.2 },
          "tooltip": [
            { "field": "bird", "type": "nominal", "title": "Bird" },
            { "field": "year", "type": "quantitative", "format": "d", "title": "Year" },
            { "field": "index", "type": "quantitative", "title": "Index" }
          ]
        }
      }
    },
    {
      "id": "did-you-know",
      "label": "Did you know?",
      "subtitle": "Several familiar garden birds have declined sharply since the 1970s",
      "bounds": { "x": 630, "y": 436, "w": 442, "h": 268 },
      "spec": {
        "width": 510,
        "height": 228,
        "background": null,
        "config": {
          "font": "'Palatino Linotype', Palatino, 'Book Antiqua', Georgia, serif",
          "view": { "stroke": null }
        },
        "data": { "values": [{ "x": 0 }] },
        "layer": [
          {
            "mark": {
              "type": "text",
              "fontSize": 74,
              "font": "'Palatino Linotype', Palatino, 'Book Antiqua', Georgia, serif",
              "fontWeight": "bold",
              "color": "#d1603d",
              "align": "center",
              "baseline": "middle",
              "dy": -52
            },
            "encoding": { "text": { "value": "−50%" } }
          },
          {
            "mark": {
              "type": "text",
              "fontSize": 16,
              "font": "'Palatino Linotype', Palatino, 'Book Antiqua', Georgia, serif",
              "color": "#4a4137",
              "align": "center",
              "baseline": "middle",
              "lineBreak": "\n",
              "dy": 18
            },
            "encoding": {
              "text": { "value": "House Sparrows have roughly halved\nsince the 1970s — yet they are still\nBritain's number-one garden bird." }
            }
          },
          {
            "mark": {
              "type": "text",
              "fontSize": 12,
              "font": "'Palatino Linotype', Palatino, 'Book Antiqua', Georgia, serif",
              "color": "#8a7f72",
              "align": "center",
              "baseline": "middle",
              "dy": 82
            },
            "encoding": { "text": { "value": "Source: RSPB Big Garden Birdwatch & BTO BirdTrends (illustrative)" } }
          }
        ]
      }
    }
  ]
}
