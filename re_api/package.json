{
  "name": "vizier-re-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LLM/API-driven critique engine for VIZier v2 (detect -> generate -> compute -> apply -> re-evaluate), served over SSE.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.ts",
