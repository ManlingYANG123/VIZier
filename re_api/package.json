    "benchmark": "node scripts/benchmark.ts",
    "report": "node scripts/report.ts"
  },
  "dependencies": {
    "vega-lite": "^6.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1"
  }
}
