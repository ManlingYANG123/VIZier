    {
      "id": "fs-06-respect-focused-scope",
      "purpose": "Answer the selected feedback scope and explicitly leave unrelated visible issues out of scope.",
      "sources": [
        {
          "dataset": "slack-replies-coded-consolidated-08-17",
          "threadId": "9",
          "replyId": "2",
          "unitId": "1",
          "adaptation": "The empirical feedback isolates a color-contrast concern and recommends a bounded palette change."
