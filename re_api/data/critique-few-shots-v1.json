              "mark": "text",
              "encoding": {
                "text": { "field": "approval", "type": "quantitative" },
                "y": { "field": "group", "type": "nominal" }
              }
            }
          }
        }
      },
      "expectedOutput": {
        "diagnoses": [
          {
            "object": "color",
            "problem": "breaks established principles",
