    {
      "id": "fs-05-keep-local-issue-local",
      "purpose": "Resolve a selected axis and explicit author instruction into one visible, local executable change.",
      "sources": [
        {
          "dataset": "slack-replies-coded-consolidated-08-17",
          "threadId": "42",
          "replyId": "1",
          "unitId": "1",
          "adaptation": "The empirical feedback identifies small text in one chart; the demonstration preserves that local target."
        }
      ],
      "input": {
        "requestScope": {
          "kind": "selected-region",
          "bounds": { "x": 28, "y": 310, "w": 300, "h": 72 },
          "request": "Make these category labels larger and angle them so they are easier to read.",
          "permittedTileIds": ["category-satisfaction"],
          "semanticTargets": [{
            "kind": "axis",
            "path": "tile.category-satisfaction.encoding",
            "tileId": "category-satisfaction",
            "text": "Service categories",
            "bounds": { "x": 28, "y": 310, "w": 300, "h": 72 },
            "overlapRatio": 0.94
          }],
          "requestContract": {
            "request": "Make these category labels larger and angle them so they are easier to read.",
            "explicitChange": true,
            "actions": ["resize", "fix"],
            "targetPaths": ["tile.category-satisfaction.encoding"],
            "targetKinds": ["axis"],
            "mustPreserve": [],
            "successCriteria": [
              "The proposed dashboard must visibly change the selected axis labels.",
              "The executable proposal must increase label size and angle the labels."
            ]
          }
        },
        "dashboardGenre": "analytical",
        "context": {
          "goal": "Compare satisfaction across service categories.",
          "fieldStatus": { "goal": "confirmed" }
        },
        "evidence": {
          "board": {
            "title": "Service satisfaction",
            "filters": [],
            "tiles": [
              { "id": "category-satisfaction", "bounds": { "x": 20, "y": 100, "w": 320, "h": 300 } },
              { "id": "monthly-satisfaction", "bounds": { "x": 360, "y": 100, "w": 640, "h": 300 } }
            ]
          },
          "specMap": {
            "category-satisfaction": {
              "mark": "bar",
              "encoding": {
                "x": {
                  "field": "service_category",
                  "type": "nominal",
                  "axis": { "labelAngle": 0, "labelFontSize": 9 }
                },
                "y": { "field": "satisfaction", "type": "quantitative" }
              }
            },
            "monthly-satisfaction": {
              "mark": "line",
              "encoding": {
                "x": { "field": "month", "type": "temporal" },
                "y": { "field": "satisfaction", "type": "quantitative" }
              }
            }
          }
        }
      },
      "expectedOutput": {
        "diagnoses": [{
          "object": "readability",
          "problem": "overly complex | difficult",
          "outcome": "evaluated_issue",
          "judgmentBasis": ["dashboard evidence", "general design principle"],
          "requiredContext": [],
          "contextStatus": "not_applicable",
          "evidenceRefs": [{
            "source": "dashboard",
            "path": "tile.category-satisfaction.encoding.x.axis",
            "tileId": "category-satisfaction",
            "field": "service_category",
            "channel": "x",
            "detail": "The narrow category chart keeps labels horizontal at 9 px."
          }],
          "rationale": "The readability weakness is supported on one tile; the other chart and board layout do not share it."
        }],
        "critiques": [{
          "object": "readability",
          "problem": "overly complex | difficult",
          "recommendation": "chart:support perception",
          "kind": "make-category-labels-readable",
          "priority": "medium",
          "surface": "text",
          "tileId": "category-satisfaction",
          "title": "Give the category labels room",
          "issue": "The category labels are difficult to scan in the narrow chart.",
          "rationale": "This is a local axis-label issue, not evidence that the whole dashboard layout is unreadable.",
          "evidence": "The category chart is 320 pixels wide and uses horizontal 9 px x-axis labels.",
          "suggestion": "Rotate the category labels and increase their font size within this chart.",
          "answer": "Yes. The selected x-axis labels should be enlarged and angled; the proposed edits make both changes on this chart only.",
          "judgmentBasis": ["dashboard evidence", "general design principle"],
          "requiredContext": [],
          "contextStatus": "not_applicable",
          "evidenceRefs": [{
            "source": "dashboard",
            "path": "tile.category-satisfaction.encoding.x.axis",
            "tileId": "category-satisfaction",
            "field": "service_category",
            "channel": "x",
            "detail": "The affected chart uses horizontal 9 px category labels."
          }],
          "proposal": {
            "kind": "edit-spec",
            "mode": "executable",
            "edits": [
              { "op": "set", "path": ["encoding", "x", "axis", "labelAngle"], "value": -35 },
              { "op": "set", "path": ["encoding", "x", "axis", "labelFontSize"], "value": 12 }
            ]
          },
          "target": { "granularity": "chart", "ref": { "tile": "category-satisfaction" } }
